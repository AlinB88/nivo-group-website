---
/**
 * NIVO 3D loading experience — PLACEHOLDER SHELL.
 *
 * This component renders no 3D content and ships no JavaScript. It exists so
 * the final visual phase can drop the real NIVO mascot in without touching
 * BaseLayout or any page.
 *
 * State today: always inert. The root element carries the `hidden` attribute,
 * so nothing paints and nothing can trap the viewport. Removing `hidden` is
 * deliberately left to the phase that also adds the code to dismiss it —
 * shipping a visible overlay with no dismiss logic would cover the site
 * permanently, since the build currently emits zero JavaScript.
 *
 * Wiring it up later (no changes required outside this file):
 *   1. Drop the mascot at `public/brand/mascot/nivo-mascot.glb` — see README.
 *   2. Add an Astro `<script>` here to load it and clear `hidden` on start,
 *      then restore `hidden` when the scene is ready.
 *   3. Respect `prefers-reduced-motion` and keep a no-JS path: if the script
 *      never runs, the element must stay hidden and the page stay usable.
 *
 * Framework note: this needs a script, not a UI framework. React was removed
 * in Phase 7 and the site emits no JS — a plain Astro `<script>` is enough for
 * a Three.js scene. Do not re-add React for this.
 *
 * Hook points, kept stable so the future script can rely on them:
 *   [data-nivo-loader]        root overlay
 *   [data-nivo-loader-stage]  canvas / mascot mount point
 */

interface Props {
  /** Announced to assistive tech while the experience is active. */
  label?: string;
}

const { label = 'Loading' } = Astro.props;
---

{
  /*
    `[&:not([hidden])]:flex` keeps the `hidden` attribute authoritative — a bare
    `flex` utility would out-rank the UA stylesheet and force the overlay
    visible.
  */
}
<div
  class="fixed inset-0 z-50 items-center justify-center bg-nivo-navy [&:not([hidden])]:flex"
  data-nivo-loader
  role="status"
  aria-live="polite"
  hidden
>
  {/* Mount point for the future 3D canvas. Intentionally empty. */}
  <div class="flex flex-col items-center gap-6" data-nivo-loader-stage>
    <span class="block h-10 w-[3px] bg-nivo-gold" aria-hidden="true"></span>
  </div>

  <span class="sr-only">{label}</span>
</div>
