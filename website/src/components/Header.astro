---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site';

// The CTA is flagged in config rather than matched on href, so changing the
// contact destination never silently duplicates it in the nav list.
const navItems = siteConfig.nav.filter((item) => !item.cta);
const cta = siteConfig.nav.find((item) => item.cta);
const currentPath = Astro.url.pathname;

const isCurrentPage = (href: string): boolean => href === currentPath;
---

<header class="nivo-site-header sticky top-0 z-30">
  <div class="nivo-container flex items-center justify-between gap-8 py-3 sm:py-4">
    <a href="/" aria-label={`Return to ${siteConfig.name} home`}>
      <BrandMark inverse />
    </a>

    {/* Desktop navigation */}
    <nav class="hidden sm:block" aria-label="Main">
      <ul class="flex items-center gap-7 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                class:list={[
                  'font-semibold tracking-wide hover:text-nivo-navy',
                  isCurrentPage(item.href) ? 'text-nivo-gold' : 'text-nivo-text-inverse-muted',
                ]}
                href={item.href}
                aria-current={isCurrentPage(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }

        {
          cta && (
            <li>
              <a class="nivo-btn nivo-btn-primary" href={cta.href}>
                {cta.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    {
      /*
      Mobile navigation. <details> gives a native disclosure widget — focusable,
      toggled by Enter/Space, and state announced by screen readers — with no
      JavaScript, so the menu still works if scripts fail. The panel is absolute
      so opening it does not change the header's height.
    */
    }
    <details class="sm:hidden">
      <summary
        class="cursor-pointer list-none py-2 text-sm font-bold tracking-[0.1em] text-nivo-text-inverse uppercase [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>

      <nav
        class="absolute inset-x-0 top-full z-10 border-b border-nivo-border bg-nivo-background px-5 pb-6 shadow-xl shadow-nivo-navy/5"
        aria-label="Main"
      >
        <ul class="flex flex-col gap-1 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a
                  class:list={[
                    'block py-3 font-semibold',
                    isCurrentPage(item.href) ? 'text-nivo-gold' : 'text-nivo-text-inverse-muted',
                  ]}
                  href={item.href}
                  aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }

          {
            cta && (
              <li class="pt-3">
                <a class="nivo-btn nivo-btn-primary w-full" href={cta.href}>
                  {cta.label}
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
