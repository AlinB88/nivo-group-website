---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site';

// The CTA is flagged in config rather than matched on href, so changing the
// contact destination never silently duplicates it in the nav list.
const navItems = siteConfig.nav.filter((item) => !item.cta);
const cta = siteConfig.nav.find((item) => item.cta);
---

<header class="relative border-b border-nivo-border bg-nivo-background">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-8 px-6 py-5">
    <a href="/">
      <BrandMark />
    </a>

    {/* Desktop navigation */}
    <nav class="hidden sm:block" aria-label="Main">
      <ul class="flex items-center gap-8 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a class="font-medium text-nivo-text-muted hover:text-nivo-navy" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }

        {
          cta && (
            <li>
              <a class="nivo-btn nivo-btn-primary" href={cta.href}>
                {cta.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    {
      /*
      Mobile navigation. <details> gives a native disclosure widget — focusable,
      toggled by Enter/Space, and state announced by screen readers — with no
      JavaScript, so the menu still works if scripts fail. The panel is absolute
      so opening it does not change the header's height.
    */
    }
    <details class="sm:hidden">
      <summary
        class="cursor-pointer list-none py-2 text-sm font-medium text-nivo-navy [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>

      <nav
        class="absolute inset-x-0 top-full z-10 border-b border-nivo-border bg-nivo-background px-6 pb-6"
        aria-label="Main"
      >
        <ul class="flex flex-col gap-1 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a class="block py-3 font-medium text-nivo-text-muted" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }

          {
            cta && (
              <li class="pt-3">
                <a class="nivo-btn nivo-btn-primary w-full" href={cta.href}>
                  {cta.label}
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
