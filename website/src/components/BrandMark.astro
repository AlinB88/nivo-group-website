---
import { siteConfig } from '../config/site';

interface Props {
  /** Renders light-on-navy, for the footer and other dark surfaces. */
  inverse?: boolean;

  /** Accessible/visible name. Defaults to the configured group name. */
  label?: string;
}

const { inverse = false, label = siteConfig.name } = Astro.props;
---

{/* The approved logo is shared by the header and footer. */}
<span class:list={['nivo-brandmark', inverse && 'nivo-brandmark--inverse']}>
  <img
    class="nivo-brandmark__asset"
    src="/brand/logo/nivo-logo.png"
    alt=""
    width="1254"
    height="1254"
    decoding="async"
  />
  <span class="nivo-brandmark__label">{label}</span>
</span>
