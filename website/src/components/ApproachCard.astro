---
import type { ApproachPrinciple } from '../config/site';

interface Props {
  principle: ApproachPrinciple;
}

const { principle } = Astro.props;
---

<article class="nivo-principle border-t border-nivo-gold/70 pt-6">
  <h3 class="text-lg text-nivo-navy">
    {principle.title}
  </h3>

  <p class="mt-4 text-sm leading-7 text-nivo-text-muted">{principle.description}</p>
</article>
