---
import type { ApproachPrinciple } from '../config/site';

interface Props {
  principle: ApproachPrinciple;
}

const { principle } = Astro.props;
---

<article class="border-t border-nivo-border pt-6">
  <h3 class="text-base font-semibold tracking-tight text-nivo-navy">
    {principle.title}
  </h3>

  <p class="mt-3 text-sm text-nivo-text-muted">{principle.description}</p>
</article>
