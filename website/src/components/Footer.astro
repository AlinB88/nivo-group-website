---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site';

// Baked at build time; static output has no request-time clock.
const year = new Date().getFullYear();

const columns = [
  { heading: 'Explore', items: siteConfig.nav },
  { heading: 'Legal', items: siteConfig.legal },
];
---

<footer class="nivo-on-navy border-t-2 border-nivo-gold bg-nivo-navy text-nivo-text-inverse-muted">
  <div class="nivo-container py-16 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_0.75fr_0.75fr_1fr]">
      <div>
        <BrandMark inverse />

        <p class="mt-2 text-lg text-nivo-text-inverse" lang="ar" dir="rtl">
          {siteConfig.nameAr}
        </p>

        <p class="mt-5 max-w-sm text-sm leading-7">{siteConfig.philosophy}</p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <p class="text-xs font-bold tracking-[0.15em] text-nivo-text-inverse uppercase">
              {column.heading}
            </p>

            <ul class="mt-5 flex flex-col gap-3 text-sm">
              {column.items.map((item) => (
                <li>
                  <a class="transition-colors hover:text-nivo-gold" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <nav aria-label="Divisions">
        <p class="text-xs font-bold tracking-[0.15em] text-nivo-text-inverse uppercase">
          Divisions
        </p>

        <ul class="mt-5 flex flex-col gap-3 text-sm">
          {
            siteConfig.divisions.map((division) => (
              <li>
                {division.url ? (
                  <a
                    class="transition-colors hover:text-nivo-gold"
                    href={division.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {division.name}
                  </a>
                ) : (
                  <span>{division.name}</span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-nivo-text-inverse-muted/20 pt-8 text-sm sm:flex-row sm:justify-between"
    >
      <p>&copy; {year} {siteConfig.name}. All rights reserved.</p>
      <p>{siteConfig.signature}</p>
    </div>
  </div>
</footer>
