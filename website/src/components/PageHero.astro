---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="bg-nivo-background">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <h1 class="nivo-rule max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      {title}
    </h1>

    {intro && <p class="mt-8 max-w-2xl text-lg text-nivo-text-muted">{intro}</p>}
  </div>
</section>
