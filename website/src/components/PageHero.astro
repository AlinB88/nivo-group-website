---
import type { SectionLink } from '../content/sections';

interface Props {
  title: string;
  intro?: string;
  links?: readonly SectionLink[];
}

const { title, intro, links = [] } = Astro.props;
---

<section class="nivo-hero-field nivo-on-navy">
  <div
    class="nivo-container grid items-end gap-10 py-20 sm:py-28 lg:grid-cols-[minmax(0,1fr)_15rem] lg:py-32"
  >
    <div>
      <h1 class="nivo-rule max-w-3xl text-4xl text-nivo-text-inverse sm:text-5xl">
        {title}
      </h1>

      {
        intro && (
          <p class="mt-8 max-w-2xl text-lg leading-8 text-nivo-text-inverse-muted sm:text-xl">
            {intro}
          </p>
        )
      }

      {
        links.length > 0 && (
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            {links.map((link) => (
              <a
                class:list={['nivo-btn', link.primary ? 'nivo-btn-gold' : 'nivo-btn-on-dark']}
                href={link.href}
              >
                {link.label.en}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <figure class="nivo-page-hero-art hidden lg:block" aria-hidden="true">
      <img
        src="/brand/mascot/nivo-3d-mark.png"
        alt=""
        width="1254"
        height="1254"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>
