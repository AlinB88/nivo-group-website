---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NivoLoader from '../components/loading/NivoLoader.astro';
import { siteConfig } from '../config/site';
import { getPage } from '../content/pages';
import '../styles/global.css';

interface Props {
  /**
   * Route path. Looks up title, description, and SEO in content/pages.ts,
   * which is authoritative for page metadata.
   */
  slug?: string;

  /** Escape hatch: overrides whatever the registry says. */
  title?: string;
  description?: string;
  ogImage?: string | null;

  /**
   * Integration point for the future NIVO 3D loading experience.
   *
   * Off by default, and the loader is inert even when enabled — see
   * components/loading/NivoLoader.astro. Opting a page in today emits the
   * hidden shell and nothing else.
   */
  loader?: boolean;
}

const { slug, title, description, ogImage, loader = false } = Astro.props;

const page = slug ? getPage(slug) : undefined;

// A missing registry entry must not fail the build — fall back to site
// defaults and surface the gap in the build log instead.
if (slug && !page) {
  console.warn(`[BaseLayout] No entry in content/pages.ts for "${slug}" — using site defaults.`);
}

const seo = page?.seo;

/*
 * Title resolution, most specific first:
 *   1. explicit `title` prop  → suffixed with the brand
 *   2. page.seo.title         → absolute, used verbatim
 *   3. root page              → the site's default positioning title
 *   4. page.title             → suffixed with the brand
 *   5. no entry               → the site's default title
 */
const suffixed = (value: string) => `${value} | ${siteConfig.name}`;

let pageTitle: string;
if (title) {
  pageTitle = suffixed(title);
} else if (seo?.title) {
  pageTitle = seo.title;
} else if (page && page.slug !== '/') {
  pageTitle = suffixed(page.title);
} else {
  pageTitle = siteConfig.seo.defaultTitle;
}

const pageDescription =
  description || seo?.description || page?.description || siteConfig.seo.metaDescription;

// canonicalPath overrides the route-derived URL; null keeps current behaviour.
const canonicalURL = new URL(seo?.canonicalPath ?? Astro.url.pathname, siteConfig.url).href;

// Absolute URL required — relative paths are not resolved by social crawlers.
const shareImage = ogImage ?? seo?.ogImage ?? siteConfig.seo.ogImage;
const shareImageURL = shareImage ? new URL(shareImage, siteConfig.url).href : null;

// A large-image card without an image renders as a broken preview.
const twitterCard = shareImageURL ? 'summary_large_image' : 'summary';

/*
 * `index,follow` is what crawlers assume with no tag at all, so emitting it
 * would add noise to every page for zero effect. Only a restrictive directive
 * is worth stating.
 */
const robots = seo?.robots ?? 'index,follow';
const emitRobots = robots !== 'index,follow';

// Never invented — empty unless real terms are supplied in the registry.
const keywords = seo?.keywords ?? [];
---

<!doctype html>
<html lang={siteConfig.seo.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />

    {emitRobots && <meta name="robots" content={robots} />}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={siteConfig.seo.locale} />
    {shareImageURL && <meta property="og:image" content={shareImageURL} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {shareImageURL && <meta name="twitter:image" content={shareImageURL} />}

    {
      /* Fixed paths: dropping approved artwork at these filenames in public/
         replaces the icons with no code change. */
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body class="flex min-h-screen flex-col">
    {loader && <NivoLoader />}

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
