---
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';
import { getPage, getPageDescription } from '../content/pages';
import { getSectionOfKind } from '../content/sections';
import BaseLayout from '../layouts/BaseLayout.astro';

const SLUG = '/privacy';

const title = getPage(SLUG)?.title ?? '';

// The hero intro and the meta description are the same sentence — sourced once
// from the registry so they cannot drift apart.
const intro = getPageDescription(SLUG);

const contactHref = siteConfig.nav.find((item) => item.cta)?.href ?? '/contact';

// Notice and clauses are owned by content/sections.ts — this file only places them.
const legal = getSectionOfKind('privacy.body', 'legal');
---

<BaseLayout slug={SLUG}>
  <PageHero title={title} intro={intro} />

  <section class="bg-nivo-surface-warm">
    <div class="nivo-container nivo-section">
      <div class="nivo-legal-copy max-w-3xl">
        <p class="border-l-2 border-nivo-gold pl-4 text-sm text-nivo-text-muted italic">
          {legal?.notice.en}
        </p>

        <div class="mt-14 flex flex-col gap-11">
          {
            legal?.clauses.map((clause) => (
              <section>
                <h2 class="text-nivo-navy">{clause.heading.en}</h2>

                <p class="mt-4 leading-8 text-nivo-text-muted">{clause.body.en}</p>
              </section>
            ))
          }
        </div>

        <div class="mt-12">
          <a class="nivo-btn nivo-btn-secondary" href={contactHref}> Contact Us </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
