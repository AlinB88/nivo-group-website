---
import DivisionCard from '../components/DivisionCard.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';
import { getSectionOfKind } from '../content/sections';
import BaseLayout from '../layouts/BaseLayout.astro';

const { email, phone, location } = siteConfig.contact;

// Null fields render a "To be provided" empty state — no address, number, or
// office is invented. Filling the value in site.ts activates the link.
const details = [
  {
    label: 'Email',
    value: email,
    href: email ? `mailto:${email}` : null,
  },
  {
    label: 'Phone',
    value: phone,
    href: phone ? `tel:${phone.replace(/\s+/g, '')}` : null,
  },
  {
    label: 'Location',
    value: location,
    href: null,
  },
];

const hasAnyDetail = details.some((detail) => detail.value);

// Body copy is owned by content/sections.ts — this file only places it.
const hero = getSectionOfKind('contact.hero', 'hero');
const groupContact = getSectionOfKind('contact.details', 'text');
const divisionRouting = getSectionOfKind('contact.divisions', 'text');
---

<BaseLayout slug="/contact">
  <PageHero title={hero?.headline.en ?? ''} intro={hero?.intro.en} />

  <section class="bg-nivo-surface-warm">
    <div class="nivo-container nivo-section">
      <h2 class="nivo-rule max-w-2xl text-3xl sm:text-4xl">
        {groupContact?.heading.en}
      </h2>

      {
        !hasAnyDetail &&
          groupContact?.body.map((paragraph) => (
            <p class="mt-8 max-w-prose text-lg leading-8 text-nivo-text-muted">{paragraph.en}</p>
          ))
      }

      <dl class="mt-12 grid gap-6 sm:grid-cols-3">
        {
          details.map((detail) => (
            <div class="border-t-2 border-nivo-gold bg-nivo-background p-6 pt-7">
              <dt class="text-xs font-bold tracking-[0.15em] text-nivo-navy uppercase">
                {detail.label}
              </dt>

              <dd class="mt-3 text-nivo-text-muted">
                {detail.value ? (
                  detail.href ? (
                    <a class="hover:text-nivo-navy" href={detail.href}>
                      {detail.value}
                    </a>
                  ) : (
                    detail.value
                  )
                ) : (
                  <span class="italic">To be provided</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-nivo-background">
    <div class="nivo-container nivo-section">
      <h2 class="nivo-rule max-w-2xl text-3xl sm:text-4xl">
        {divisionRouting?.heading.en}
      </h2>

      {
        divisionRouting?.body.map((paragraph) => (
          <p class="mt-8 max-w-2xl text-lg leading-8 text-nivo-text-muted">{paragraph.en}</p>
        ))
      }

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {siteConfig.divisions.map((division) => <DivisionCard division={division} />)}
      </div>
    </div>
  </section>
</BaseLayout>
