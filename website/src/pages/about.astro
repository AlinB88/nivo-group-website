---
import GroupApproachSection from '../components/GroupApproachSection.astro';
import GroupCallToAction from '../components/GroupCallToAction.astro';
import PageHero from '../components/PageHero.astro';
import { getSectionOfKind } from '../content/sections';
import BaseLayout from '../layouts/BaseLayout.astro';

const SLUG = '/about';

// Both sections are shared with the home page, keeping the approved group
// narrative in one registry entry rather than maintaining two copies.
const about = getSectionOfKind('group.about', 'text');
const approach = getSectionOfKind('group.approach', 'text');
const contact = getSectionOfKind('group.contact', 'cta');
const intro = about?.body[0]?.en;
---

<BaseLayout slug={SLUG}>
  <PageHero title={about?.heading.en ?? ''} intro={intro} />
  <GroupApproachSection section={approach} />
  <GroupCallToAction section={contact} />
</BaseLayout>
