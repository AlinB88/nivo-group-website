---
import DivisionCard from '../components/DivisionCard.astro';
import GroupCallToAction from '../components/GroupCallToAction.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';
import { getSectionOfKind } from '../content/sections';
import BaseLayout from '../layouts/BaseLayout.astro';

const SLUG = '/divisions';

// The approved group description and CTA are shared with the homepage so the
// same business copy has one owner and cannot drift between public pages.
const divisions = getSectionOfKind('group.divisions', 'text');
const contact = getSectionOfKind('group.contact', 'cta');
const intro = divisions?.body[0]?.en;
---

<BaseLayout slug={SLUG}>
  <PageHero title={divisions?.heading.en ?? ''} intro={intro} />

  <section class="bg-nivo-surface-warm" aria-labelledby="division-list-heading">
    <div class="nivo-container nivo-section">
      <h2 id="division-list-heading" class="sr-only">{divisions?.heading.en}</h2>

      <div class="grid gap-6 sm:grid-cols-2">
        {siteConfig.divisions.map((division) => <DivisionCard division={division} />)}
      </div>
    </div>
  </section>

  <GroupCallToAction section={contact} />
</BaseLayout>
