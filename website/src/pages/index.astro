---
import DivisionCard from '../components/DivisionCard.astro';
import GroupApproachSection from '../components/GroupApproachSection.astro';
import GroupCallToAction from '../components/GroupCallToAction.astro';
import { siteConfig } from '../config/site';
import { getSectionOfKind } from '../content/sections';
import BaseLayout from '../layouts/BaseLayout.astro';

const SLUG = '/';

// Body copy is owned by content/sections.ts — this file only places it.
const hero = getSectionOfKind('home.hero', 'hero');
const about = getSectionOfKind('group.about', 'text');
const approach = getSectionOfKind('group.approach', 'text');
const divisions = getSectionOfKind('group.divisions', 'text');
const contact = getSectionOfKind('group.contact', 'cta');

const [exploreCta, contactCta] = hero?.links ?? [];
---

<BaseLayout slug={SLUG}>
  <!-- Hero Section -->
  <section id="hero" class="nivo-home-hero nivo-on-navy">
    <div
      class="nivo-container grid min-h-[42rem] items-center gap-12 py-20 sm:py-28 lg:min-h-[48rem] lg:grid-cols-[minmax(0,1fr)_minmax(16rem,24rem)] lg:py-24"
    >
      <div class="relative z-10">
        <h1 class="nivo-rule nivo-display max-w-4xl text-nivo-text-inverse">
          {hero?.headline.en}
        </h1>

        <p class="mt-10 max-w-2xl text-xl leading-relaxed text-nivo-text-inverse sm:text-2xl">
          {hero?.subheadline.en}
        </p>

        <p class="mt-5 max-w-2xl text-lg text-nivo-gold sm:text-xl" lang="ar" dir="rtl">
          {hero?.subheadline.ar}
        </p>

        <p class="mt-10 max-w-xl text-base leading-8 text-nivo-text-inverse-muted sm:text-lg">
          {hero?.intro.en}
        </p>

        <div class="mt-12 flex flex-col gap-4 sm:flex-row">
          <a class="nivo-btn nivo-btn-gold" href={exploreCta?.href}> {exploreCta?.label.en} </a>

          <a class="nivo-btn nivo-btn-on-dark" href={contactCta?.href}> {contactCta?.label.en} </a>
        </div>
      </div>

      <figure class="nivo-home-hero-art hidden lg:block" aria-hidden="true">
        <picture>
          <source media="(min-width: 1024px)" srcset="/brand/mascot/nivo-stamp.png" />
          <img
            src="/brand/mascot/nivo-3d-mark.png"
            alt=""
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="nivo-about-band nivo-on-navy">
    <div
      class="nivo-container nivo-section grid gap-10 lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-16"
    >
      <span class="nivo-eyebrow" aria-hidden="true">01</span>
      <div>
        <h2 class="nivo-rule max-w-2xl text-3xl text-nivo-text-inverse sm:text-4xl">
          {about?.heading.en}
        </h2>

        {
          about?.body.map((paragraph) => (
            <p class="mt-8 max-w-3xl text-lg leading-8 text-nivo-text-inverse-muted sm:text-xl">
              {paragraph.en}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Our Approach Section -->
  <GroupApproachSection section={approach} id="approach" index="02" />

  <!-- Divisions Section -->
  <section id="divisions" class="nivo-divisions-band">
    <div
      class="nivo-container nivo-section grid gap-10 lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-16"
    >
      <span class="nivo-eyebrow" aria-hidden="true">03</span>
      <div>
        <h2 class="nivo-rule max-w-2xl text-3xl sm:text-4xl">
          {divisions?.heading.en}
        </h2>

        {
          divisions?.body.map((paragraph) => (
            <p class="mt-8 max-w-2xl text-lg leading-8 text-nivo-text-inverse-muted">
              {paragraph.en}
            </p>
          ))
        }

        <div class="mt-14 grid gap-6 sm:grid-cols-2">
          {siteConfig.divisions.map((division) => <DivisionCard division={division} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA Section -->
  <GroupCallToAction section={contact} index="04" />
</BaseLayout>
